# Dockerfile.frontend — Multi-stage build for the Vite/React frontend
# Stage 1 (builder): Node 22, installs deps, builds with VITE_API_BASE_URL
# Stage 2 (runtime): nginx:alpine serving the static dist/ on port 80

# ── Stage 1: builder ──────────────────────────────────────────────────────────
FROM node:22-alpine AS builder

WORKDIR /build

# Copy package manifests — layer-cached unless deps change
COPY frontend/package.json frontend/pnpm-lock.yaml ./

# Install pnpm then install frozen deps
RUN corepack enable && pnpm install --frozen-lockfile

# Copy the rest of the frontend source
COPY frontend/ ./

# VITE_API_BASE_URL is baked into the bundle at build time (D-ENTRY-10)
ARG VITE_API_BASE_URL
ENV VITE_API_BASE_URL=${VITE_API_BASE_URL}

RUN pnpm run build

# ── Stage 2: runtime ──────────────────────────────────────────────────────────
FROM nginx:alpine AS runtime

# Remove default nginx welcome page
RUN rm -rf /usr/share/nginx/html/*

# Copy built assets from builder
COPY --from=builder /build/dist /usr/share/nginx/html

# Minimal nginx config: serve static files, route all SPA paths to index.html
RUN printf 'server {\n\
    listen 80;\n\
    root /usr/share/nginx/html;\n\
    index index.html;\n\
\n\
    # Cache static assets\n\
    location ~* \\.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$ {\n\
        expires 1y;\n\
        add_header Cache-Control "public, immutable";\n\
    }\n\
\n\
    # SPA fallback — all routes to index.html\n\
    location / {\n\
        try_files $uri $uri/ /index.html;\n\
    }\n\
}\n' > /etc/nginx/conf.d/default.conf

EXPOSE 80
